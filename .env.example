# AgriSaathi AI - Environment Configuration Example
# Copy this file to .env and configure values for local development.

# Database
# Default SQLite local database:
DATABASE_URL=sqlite:///./data/agrisaathi.db
# For PostgreSQL migration in production:
# DATABASE_URL=postgresql://user:password@localhost:5432/agrisaathi

# AI Provider Configuration
# Options: "gemini" (recommended, fast & reliable) or "ollama" (offline local CPU)
AI_PROVIDER=gemini
ENABLE_OLLAMA_FALLBACK=false

# Google Gemini API Configuration (Primary Provider)
# Obtain your key at https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TEMPERATURE=0.3
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_TIMEOUT_SECONDS=30

# Local Ollama AI Configuration (Secondary / Offline Fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT_SECONDS=180
OLLAMA_TEMPERATURE=0.3
MAX_CHAT_HISTORY=4

# Application Settings
APP_ENV=development
SECRET_KEY=dev-secret-key-agrisaathi-farmer-companion-2026
DEFAULT_LANGUAGE=en

# File Upload Settings
MAX_UPLOAD_SIZE_MB=5

# Optional External API Keys (Leave blank for fallback providers)
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
# External APMC Mandi Rates (Government of India data.gov.in)
# Register at https://data.gov.in/ to get your free API key
DATA_GOV_API_KEY=
DATA_GOV_IN_API_KEY=
MANDI_CACHE_TTL_MINUTES=60
MANDI_MAX_RECORDS=100
WEATHER_API_KEY=
