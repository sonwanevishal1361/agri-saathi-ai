# .streamlit/secrets.toml.example
# Copy this file to .streamlit/secrets.toml for local development or enter these in Streamlit Cloud -> App Settings -> Secrets.
# WARNING: NEVER commit your actual secrets.toml file to git.

# Database URL (Managed Neon PostgreSQL or SQLite for local dev)
DATABASE_URL = "postgresql://user:password@ep-your-instance.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Google Gemini API Key (Obtain from https://aistudio.google.com/)
GEMINI_API_KEY = "your_gemini_api_key_here"
GEMINI_MODEL = "gemini-2.5-flash"

# Government of India Open Data Platform (Agmarknet Mandi Rates)
# Register at https://data.gov.in/ to get your free personal API key
DATA_GOV_API_KEY = "your_data_gov_in_api_key_here"

# Application Settings
APP_ENV = "development"
ADMIN_EMAIL = "admin@yourdomain.com"
ADMIN_PASSWORD = "YourSecurePassword2026!"
AI_DAILY_REQUEST_LIMIT = "25"
